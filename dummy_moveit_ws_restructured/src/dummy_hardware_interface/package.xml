<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dummy_hardware_interface</name>
  <version>0.1.0</version>
  <description>ros2_control hardware interface for the Dummy arm, with full ASCII protocol support derived from the STM32 firmware.</description>
  <maintainer email="xin.li@switchpi.com">workspace-rebuild</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/dummy_hardware_interface.xml"/>
  </export>
</package>
