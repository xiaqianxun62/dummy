<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dummy_moveit_config</name>
  <version>0.3.1</version>
  <description>MoveIt 2 configuration package for the Dummy arm, rebuilt from the original dummy_moveit_ws structure.</description>
  <maintainer email="xin.li@switchpi.com">muzixiaowen</maintainer>
  <license>BSD-3-Clause</license>

  <url type="website">http://moveit.ros.org/</url>
  <url type="repository">https://github.com/ros-planning/moveit2</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>control_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>controller_manager</depend>
  <depend>dummy_hardware_interface</depend>
  <depend>dummy_ros2_description</depend>
  <depend>geometry_msgs</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>launch_param_builder</depend>
  <depend>moveit_configs_utils</depend>
  <depend>moveit_kinematics</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_planners_ompl</depend>
  <depend>moveit_ros_move_group</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_ros_visualization</depend>
  <depend>moveit_ros_warehouse</depend>
  <depend>moveit_servo</depend>
  <depend>moveit_simple_controller_manager</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>robot_state_publisher</depend>
  <depend>ros2_controllers</depend>
  <depend>rviz2</depend>
  <depend>tf2_ros</depend>
  <depend>xacro</depend>

  <exec_depend>warehouse_ros_mongo</exec_depend>
  <exec_depend>moveit_setup_assistant</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
