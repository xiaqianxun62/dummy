<Window x:Class="DummyWpfUpper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dummy Arm - WPF Upper"
        Height="820" Width="1120"
        MinHeight="700" MinWidth="980">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="64" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="串口连接" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="端口" />
                <ComboBox Width="140" Margin="6,0"
                          ItemsSource="{Binding Ports}"
                          SelectedItem="{Binding SelectedPort, Mode=TwoWay}" />
                <Button Content="刷新" Command="{Binding RefreshPortsCommand}" />
                <TextBlock Text="8N1  无流控  波特率见设置" Margin="18,0,0,0" />
                <Button Content="连接" Command="{Binding ConnectCommand}" Margin="24,0,0,0" />
                <Button Content="断开" Command="{Binding DisconnectCommand}" />
                <Button Content="3D 视图" Click="Open3DView_Click" Margin="18,0,0,0" />
                <Button Content="保存配置" Command="{Binding SaveConfigCommand}" Margin="8,0,0,0" />
                <Button Content="导出日志" Command="{Binding ExportLogsCommand}" />
                <Button Content="切换仿真" Command="{Binding ToggleSimulationCommand}" Margin="18,0,0,0" />
                <TextBlock Text="{Binding ConnectionStatus}" Margin="18,0,0,0" FontWeight="SemiBold" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="控制" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Width="250">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="START" Command="{Binding StartCommand}" />
                        <Button Content="STOP" Command="{Binding StopCommand}" />
                        <Button Content="DISABLE" Command="{Binding DisableCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="HOME" Command="{Binding HomeCommand}" />
                        <Button Content="RESET" Command="{Binding ResetCommand}" />
                        <Button Content="CALIB" Command="{Binding CalibrationCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="SET HOME I" Command="{Binding SetHomeCurrentCommand}" />
                        <Button Content="HOME OFF" Command="{Binding GetHomeOffsetCommand}" />
                        <Button Content="BASE POS" Command="{Binding GetBasePosCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                        <TextBlock Text="模式" Width="34" />
                        <TextBox Width="50" Text="{Binding CommandModeInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="SET MODE" Command="{Binding SetCommandModeCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,8,0,0">
                        <TextBlock Text="速度" Width="34" />
                        <TextBox Width="70" Text="{Binding SpeedInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="步长" Width="34" Margin="8,0,0,0" />
                        <TextBox Width="50" Text="{Binding JogStepInput, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="关节目标 (deg)：j1,j2,j3,j4,j5,j6" FontWeight="SemiBold" />
                    <TextBox Text="{Binding JointTargetInput, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="发送关节目标 (>j)" Command="{Binding SendJointCommand}" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                    <TextBlock Text="笛卡尔目标 (mm/deg)：x,y,z,a,b,c" FontWeight="SemiBold" />
                    <TextBox Text="{Binding PoseTargetInput, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="发送位姿目标 (@x)" Command="{Binding SendPoseCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Expander Grid.Row="2" Header="设置（协议参数 / 坐标映射，点击展开）" Margin="0,8,0,0">
            <WrapPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="波特率" Width="48" />
                    <TextBox Width="70" Text="{Binding BaudRateInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="关节前缀" Width="56" />
                    <TextBox Width="40" Text="{Binding CommandPrefixInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="查询超时" Width="56" />
                    <TextBox Width="60" Text="{Binding QueryTimeoutInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="ACK超时" Width="52" />
                    <TextBox Width="60" Text="{Binding MotionAckTimeoutInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="慢命令超时" Width="68" />
                    <TextBox Width="70" Text="{Binding SlowTimeoutInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="默认速度" Width="56" />
                    <TextBox Width="60" Text="{Binding SpeedInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="偏移(rad)" Width="56" />
                    <TextBox Width="180" Text="{Binding OffsetInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="符号" Width="34" />
                    <TextBox Width="140" Text="{Binding SignInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="碰撞半径(mm)" Width="88" ToolTip="L0~L6 七段各自的检测半径" />
                    <TextBox Width="210" Text="{Binding CollisionRadiusInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="安全余量(mm)" Width="88" ToolTip="L0~L6 七段各自的安全余量，两段间取较大值" />
                    <TextBox Width="210" Text="{Binding CollisionMarginInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="离地高度(mm)" Width="88" ToolTip="L0~L6 七段各自的最低允许 Z 值" />
                    <TextBox Width="210" Text="{Binding CollisionGroundInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Content="应用设置" Command="{Binding ApplySettingsCommand}" Margin="12,4,4,4" />
                <CheckBox Content="断线自动重连" IsChecked="{Binding AutoReconnect}" Margin="16,4,4,4" />
                <Separator Width="12" />
                <TextBlock Text="节点" Width="30" />
                <TextBox Width="40" Text="{Binding MotorNodeInput, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="数值" Width="30" Margin="8,0,0,0" />
                <TextBox Width="70" Text="{Binding DceValueInput, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="SET KP" Command="{Binding SetDceKpCommand}" />
                <Button Content="SET KI" Command="{Binding SetDceKiCommand}" />
                <Button Content="SET KD" Command="{Binding SetDceKdCommand}" />
                <Button Content="REBOOT" Command="{Binding RebootMotorCommand}" />
            </WrapPanel>
        </Expander>

        <GroupBox Grid.Row="3" Header="笛卡尔 Servo（速度伺服）" Padding="8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Twist" Width="38" />
                <TextBox Width="230" Text="{Binding TwistInput, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="vx,vy,vz,wx,wy,wz (mm/s, deg/s)" Margin="6,0,0,0" Foreground="Gray" />
                <TextBlock Text="坐标系" Margin="16,0,0,0" />
                <ComboBox Width="70" SelectedItem="{Binding ServoFrameInput, Mode=TwoWay}">
                    <ComboBoxItem Content="base" />
                    <ComboBoxItem Content="tool" />
                </ComboBox>
                <Button Content="启动 Servo" Command="{Binding StartServoCommand}" Margin="12,0,0,0" />
                <Button Content="停止 Servo" Command="{Binding StopServoCommand}" />
                <TextBlock Text="{Binding ServoStatusText}" Margin="12,0,0,0" FontWeight="SemiBold" />
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="实时状态" Padding="8">
                <StackPanel>
                    <TextBlock Text="关节角 (deg)" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding JointText}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="关节速度 (deg/s)" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding VelocityText}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="末端位姿 (mm / deg)" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding PoseText}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="HOME 偏移 (deg)" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding HomeOffsetText}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="基座位置 (mm)" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding BasePosText}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding QueueText}" FontWeight="SemiBold" Margin="0,12,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="点动（按住连续发送）" Padding="8" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="关节 J1~J6，步长见控制区" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding JogRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Label}" Width="30" />
                                    <Button Content="-" Width="38" Tag="{Binding Index}"
                                            PreviewMouseLeftButtonDown="JointJogDown"
                                            PreviewMouseLeftButtonUp="JointJogUp"
                                            MouseLeave="JointJogUp" />
                                    <Button Content="+" Width="38" Tag="{Binding Index}"
                                            PreviewMouseLeftButtonDown="JointJogDown"
                                            PreviewMouseLeftButtonUp="JointJogUp"
                                            MouseLeave="JointJogUp" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="笛卡尔 X/Y/Z，步长(mm)" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <TextBox Text="{Binding CartesianJogStepInput, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left" />
                    <ItemsControl ItemsSource="{Binding CartesianAxes}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Label}" Width="30" />
                                    <Button Content="-" Width="38" Tag="{Binding Index}"
                                            PreviewMouseLeftButtonDown="CartesianJogDown"
                                            PreviewMouseLeftButtonUp="CartesianJogUp"
                                            MouseLeave="CartesianJogUp" />
                                    <Button Content="+" Width="38" Tag="{Binding Index}"
                                            PreviewMouseLeftButtonDown="CartesianJogDown"
                                            PreviewMouseLeftButtonUp="CartesianJogUp"
                                            MouseLeave="CartesianJogUp" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="停止点动" Command="{Binding StopJogCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="示教 / 路径播放" Padding="8" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding TaughtPoints}"
                             SelectedIndex="{Binding SelectedPointIndex, Mode=TwoWay}"
                             MinHeight="70" FontFamily="Consolas" FontSize="12" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="记录当前点" Command="{Binding RecordPointCommand}" />
                        <Button Content="删除" Command="{Binding DeletePointCommand}" />
                        <Button Content="清空" Command="{Binding ClearPointsCommand}" />
                    </StackPanel>

                    <WrapPanel Grid.Row="2" Margin="4,2">
                        <TextBlock Text="插值步数" Width="56" />
                        <TextBox Width="50" Text="{Binding InterpolationStepsInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="间隔ms" Width="48" Margin="8,0,0,0" />
                        <TextBox Width="60" Text="{Binding PlayIntervalInput, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="时间参数化" IsChecked="{Binding UseTimeParameterization}" Margin="10,0,0,0" />
                        <TextBlock Text="Vmax" Width="40" Margin="8,0,0,0" />
                        <TextBox Width="55" Text="{Binding MaxVelocityInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Amax" Width="40" Margin="8,0,0,0" />
                        <TextBox Width="55" Text="{Binding MaxAccelInput, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="碰撞检查" IsChecked="{Binding EnableCollisionCheck}" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding CollisionText}" Margin="10,0,0,0" Foreground="DarkSlateGray" />
                    </WrapPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="播放路径" Command="{Binding PlayPathCommand}" />
                        <Button Content="停止播放" Command="{Binding StopPlayCommand}" />
                        <TextBlock Text="{Binding PathStatusText}" Margin="8,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="RRT 规划避障" Command="{Binding PlanPathCommand}" />
                        <Button Content="播放规划" Command="{Binding PlayPlannedCommand}" />
                        <TextBlock Text="{Binding PlannedStatusText}" Margin="8,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>

                    <WrapPanel Grid.Row="5" Margin="0,8,0,0">
                        <TextBlock Text="命名姿态" FontWeight="SemiBold" Margin="0,0,6,0" />
                        <ComboBox Width="100" ItemsSource="{Binding NamedPoses}"
                                  SelectedItem="{Binding NamedPoseNameInput, Mode=TwoWay}" />
                        <TextBox Width="90" Text="{Binding NamedPoseNameInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="保存" Command="{Binding SavePoseCommand}" />
                        <Button Content="调用" Command="{Binding RecallPoseCommand}" />
                        <Button Content="删除" Command="{Binding DeletePoseCommand}" />
                    </WrapPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="5" Header="日志" Padding="4" Margin="0,8,0,0">
            <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12" />
        </GroupBox>
    </Grid>
</Window>
