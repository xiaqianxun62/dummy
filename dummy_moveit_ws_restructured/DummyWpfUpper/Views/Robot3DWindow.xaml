<Window x:Class="DummyWpfUpper.Views.Robot3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dummy 机械臂 3D 视图"
        Background="#F4F7FB"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Height="720" Width="960"
        MinHeight="500" MinWidth="700">

    <Window.Resources>
        <SolidColorBrush x:Key="ViewportBgBrush" Color="#1E293B" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#D9E2EC"
                                BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource ViewportBgBrush}">
        <Viewport3D x:Name="Viewport"
                    MouseDown="Viewport_MouseDown"
                    MouseMove="Viewport_MouseMove"
                    MouseUp="Viewport_MouseUp"
                    MouseWheel="Viewport_MouseWheel">
            <Viewport3D.Camera>
                <PerspectiveCamera Position="0.75,-0.75,0.60"
                                   LookDirection="-0.75,0.75,-0.45"
                                   UpDirection="0,0,1"
                                   FieldOfView="45" />
            </Viewport3D.Camera>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#FF666666" />
                        <DirectionalLight Color="#FFFFFFFF" Direction="-1,-1,-2" />
                        <DirectionalLight Color="#FF888888" Direction="1,1,-1" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <ModelVisual3D x:Name="RobotRoot" />
        </Viewport3D>

        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                Margin="12" Padding="12,8"
                Background="#E6FFFFFF" BorderBrush="#D9E2EC" BorderThickness="1"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="鼠标左键旋转 / 滚轮缩放 / 右键平移"
                           FontSize="12" Foreground="#333333" />
                <TextBlock Text="姿态随状态轮询实时更新，橙色虚影显示关节目标"
                           FontSize="12" Foreground="#333333" Margin="0,2,0,0" />
                <TextBlock Text="橙色=规划路径  橙色虚影=关节目标  青色=示教路径  绿/红=起终点"
                           FontSize="12" Foreground="#333333" Margin="0,2,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="ShowPathCheck" Content="显示路径" IsChecked="False"
                              Checked="ShowPathCheck_Changed" Unchecked="ShowPathCheck_Changed" />
                    <Button x:Name="PreviewButton" Content="轨迹预览" Margin="10,0,0,0"
                            Padding="8,2" Click="PreviewButton_Click" />
                    <TextBlock x:Name="PathInfoText" Text="未加载路径" Margin="10,0,0,0"
                               Foreground="#333333" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
