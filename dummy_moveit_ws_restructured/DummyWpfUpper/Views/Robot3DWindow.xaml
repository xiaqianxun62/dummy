<Window x:Class="DummyWpfUpper.Views.Robot3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dummy 机械臂 3D 视图"
        Height="720" Width="960"
        MinHeight="500" MinWidth="700">

    <Grid>
        <Viewport3D x:Name="Viewport"
                    MouseDown="Viewport_MouseDown"
                    MouseMove="Viewport_MouseMove"
                    MouseUp="Viewport_MouseUp"
                    MouseWheel="Viewport_MouseWheel">
            <Viewport3D.Camera>
                <PerspectiveCamera Position="0.75,-0.75,0.60"
                                   LookDirection="-0.75,0.75,-0.45"
                                   UpDirection="0,0,1"
                                   FieldOfView="45" />
            </Viewport3D.Camera>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#FF666666" />
                        <DirectionalLight Color="#FFFFFFFF" Direction="-1,-1,-2" />
                        <DirectionalLight Color="#FF888888" Direction="1,1,-1" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <ModelVisual3D x:Name="RobotRoot" />
        </Viewport3D>

        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                Margin="12" Padding="10,6"
                Background="#CCFFFFFF" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="鼠标左键旋转 / 滚轮缩放 / 右键平移"
                           FontSize="12" Foreground="#333333" />
                <TextBlock Text="姿态随状态轮询实时更新（20Hz）"
                           FontSize="12" Foreground="#333333" Margin="0,2,0,0" />
                <TextBlock Text="橙色=规划路径  青色=示教路径  绿/红=起终点"
                           FontSize="12" Foreground="#333333" Margin="0,2,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="ShowPathCheck" Content="显示路径" IsChecked="True"
                              Checked="ShowPathCheck_Changed" Unchecked="ShowPathCheck_Changed" />
                    <Button x:Name="PreviewButton" Content="轨迹预览" Margin="10,0,0,0"
                            Padding="8,2" Click="PreviewButton_Click" />
                    <TextBlock x:Name="PathInfoText" Text="未加载路径" Margin="10,0,0,0"
                               Foreground="#333333" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
